{
	"name": "PL_API_Orders_To_PostgreSQL",
	"properties": {
		"activities": [
			{
				"name": "GetToken",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "SetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://adf-oauth-api-orders-bhhhdsdjemc3c9c7.centralindia-01.azurewebsites.net/oauth/token",
					"body": {
						"grant_type": "client_credentials",
						"client_id": "demo-client",
						"client_secret": "demo-secret"
					}
				}
			},
			{
				"name": "SetToken",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetToken",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "token",
					"value": {
						"value": "@activity('GetToken').output.access_token",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CopyOrders",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "SetToken",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"additionalHeaders": {
							"Authorization": {
								"value": "@concat('Bearer ', variables('token'))",
								"type": "Expression"
							}
						},
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "AzurePostgreSqlSink",
						"writeBatchSize": 1000000,
						"writeBatchTimeout": "00:30:00",
						"preCopyScript": "TRUNCATE TABLE staging.stg_carts;",
						"writeMethod": "CopyCommand"
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['id']"
								},
								"sink": {
									"name": "cart_id",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['discountedTotal']"
								},
								"sink": {
									"name": "discounted_total",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['total']"
								},
								"sink": {
									"name": "total",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['userId']"
								},
								"sink": {
									"name": "user_id",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['totalProducts']"
								},
								"sink": {
									"name": "total_products",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['totalQuantity']"
								},
								"sink": {
									"name": "total_quantity",
									"type": "Int32"
								}
							}
						],
						"collectionReference": "$['carts']"
					}
				},
				"inputs": [
					{
						"referenceName": "DS_REST_Orders",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Staging_Carts",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "DF_CartItems",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "SetToken",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "dataflow1",
						"type": "DataFlowReference",
						"parameters": {
							"token": {
								"value": "'@{variables('token')}'",
								"type": "Expression"
							},
							"watermark": {
								"value": "'@{variables('lastWatermark')}'",
								"type": "Expression"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "GetWatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzurePostgreSqlSource",
						"query": {
							"value": "SELECT watermark_value\nFROM etl.watermark\nWHERE source_name = 'DummyJSON'\n  AND entity_name = 'Orders';",
							"type": "Expression"
						},
						"partitionOption": "None",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "AzurePostgreSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "SetWatermark",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "lastWatermark",
					"value": {
						"value": "@string(activity('GetWatermark').output.firstRow.watermark_value)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "MergeCarts",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "DF_CartItems",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_PostgreSQL_DE",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "CALL curated.merge_carts();"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "MergeCartItems",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "MergeCarts",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_PostgreSQL_DE",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "CALL curated.merge_cart_items();"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "PipelineFailure",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "GetToken",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "CopyOrders",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "DF_CartItems",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "MergeCarts",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "MergeCartItems",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Orders ETL pipeline failed. Check the failed activity for details.",
					"errorCode": "ORDERS_ETL_FAILURE"
				}
			},
			{
				"name": "UpdateWatermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "MergeCartItems",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_PostgreSQL_DE",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "CALL etl.update_orders_watermark();"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"variables": {
			"token": {
				"type": "String"
			},
			"lastWatermark": {
				"type": "String",
				"defaultValue": "0"
			}
		},
		"annotations": []
	}
}
